meta {
  name: Cancel (Coach → Alternatives)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/appointments/{{appointmentId}}/cancel
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

body:json {
  {
    "reason": "walkthrough demo"
  }
}

tests {
  test("returns 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Coach cancellation triggers the suggested-alternatives email (subject to the effective policy window). Fetch Dev → List Notifications next — its post-script extracts {{alternativeToken}} from the first suggestion link. Note: after Reassign, the appointment belongs to the NEW coach — mint that coach's token, or cancel as admin/member instead.
}
