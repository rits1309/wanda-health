meta {
  name: Resolve Reschedule Link (Public)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/reschedule?token={{rescheduleToken}}
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Public tokened resolver: the appointment + the same coach's bookable slots. No bearer auth — the emailed token is the credential. 404 invalid, 410 expired/spent/no-longer-open.
}
