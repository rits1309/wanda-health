meta {
  name: Create Policy
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/cancellation-policies
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "scope": "programme",
    "programme_id": "p-1",
    "cancellation_window_hours": 24,
    "cancellation_allowed_by": "both"
  }
}

tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Creates a new immutable version and deactivates the previous one. Admin-only, programme-scoped (provisional configuration authority).
}
