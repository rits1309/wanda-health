meta {
  name: Book On Behalf (Coach)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/appointments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

body:json {
  {
    "slot_id": "{{slotId2}}",
    "member_id": "m-3",
    "language_matched": false
  }
}

tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Coach books their own slot for a member; created_by records the actor. Admins do the same with ?coach_id=<id> (attribution recorded end-to-end).
}
