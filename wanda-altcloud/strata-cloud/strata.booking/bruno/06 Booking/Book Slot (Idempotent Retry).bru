meta {
  name: Book Slot (Idempotent Retry)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/appointments
  body: json
  auth: none
}

headers {
  Idempotency-Key: m-1:{{slotId}}
  Authorization: Bearer {{memberToken}}
}

body:json {
  {
    "slot_id": "{{slotId}}",
    "language_matched": false
  }
}

tests {
  test("retry replays with 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("same appointment", function () {
    expect(res.getBody().id).to.equal(bru.getEnvVar("appointmentId"));
  });
}
