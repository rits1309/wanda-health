meta {
  name: Book Slot
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/appointments
  body: json
  auth: none
}

headers {
  Idempotency-Key: m-1:{{slotId}}
  Authorization: Bearer {{memberToken}}
}

body:json {
  {
    "slot_id": "{{slotId}}",
    "language_matched": false
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    bru.setEnvVar("appointmentId", res.getBody().id);
  }
}

tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Books the first browsed slot. The Idempotency-Key is member_id:slot_id — replay this request and it returns 200 with the same appointment.
}
