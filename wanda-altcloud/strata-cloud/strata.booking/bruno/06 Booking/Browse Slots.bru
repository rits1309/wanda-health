meta {
  name: Browse Slots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/slots?from={{fromDate}}&to={{toDate}}&language_match=false
  auth: none
}

headers {
  Authorization: Bearer {{memberToken}}
}

script:post-response {
  const body = res.getBody();
  if (Array.isArray(body) && body.length) {
    // The walkthrough acts as coach c-1 and needs slots outside the 24h policy
    // window (the manual steps say "pick a slot more than 24h out" on c-1) —
    // select those so the collection also runs headlessly (bru run -r).
    const cutoff = new Date(Date.now() + 25 * 3600 * 1000);
    const usable = body.filter(s => s.coach_id === "c-1" && new Date(s.start_utc) > cutoff);
    const pick = usable.length ? usable : body;
    bru.setEnvVar("slotId", pick[0].slot_id);
    if (pick[1]) bru.setEnvVar("slotId2", pick[1].slot_id);
    if (pick[2]) bru.setEnvVar("slotId3", pick[2].slot_id);
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Available slots across the member's programme coaches. language_match=true restricts to coaches speaking the member's preferred language. Saves the first three slot ids for the booking/reschedule requests.
}
