meta {
  name: List Members
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/members
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("carries no email", function () {
    res.getBody().forEach(function (member) {
      expect(member).to.not.have.property("email");
    });
  });
}

docs {
  Scoped members listing: the coach's programmes' members, ordered by
  display name. Admins list administered programmes, or pass ?coach_id= to narrow
  to the acted-for coach's programmes. Payload carries id / display_name /
  preferred_language / timezone only.
}
