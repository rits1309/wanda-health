meta {
  name: Create Block
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/unavailability-blocks
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

body:json {
  {
    "date": "{{toDate}}",
    "start_time_local": "12:00",
    "end_time_local": "13:00",
    "timezone": "America/New_York"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("blockId", res.getBody().id);
  }
}

tests {
  test("returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  One-off unavailable time; overlapping slots become unavailable, booked ones route through the alternatives flow.
}
