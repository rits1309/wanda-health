meta {
  name: Create Call Record
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/dev/call-records
  body: json
  auth: none
}

body:json {
  {
    "coach_id": "c-1",
    "member_id": "m-1"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Simulates 'a Twilio call was initiated' now — feeds no-show detection: an appointment past start+grace with a call in [start−5min, now] completes; without one it becomes no_show.
}
