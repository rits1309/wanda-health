meta {
  name: Admin Calendar
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/admin/calendar?from={{fromDate}}&to={{toDate}}&layers=booked
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Combined multi-coach calendar. Repeat coach_ids= to filter the coach set; repeat layers= (available|booked|unavailable) to toggle layers.
}
