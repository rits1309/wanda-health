meta {
  name: Coach Calendar
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/coaches/c-1/calendar?from={{fromDate}}&to={{toDate}}
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  All layers: available / booked (with appointment summary) / unavailable.
}
