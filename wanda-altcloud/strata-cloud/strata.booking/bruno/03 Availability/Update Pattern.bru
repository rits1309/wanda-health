meta {
  name: Update Pattern
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/availability-patterns/{{patternId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{coachToken}}
}

body:json {
  {
    "days_of_week": [
      1
    ],
    "start_time_local": "11:00",
    "end_time_local": "13:00",
    "slot_duration_minutes": 20,
    "timezone": "America/New_York",
    "active_from": "{{fromDate}}",
    "active_to": "{{toDate}}"
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Versioned update; future slots regenerate. Booked slots no longer honoured route through the alternatives flow.
}
