meta {
  name: Mint Member Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/dev/tokens
  body: json
  auth: none
}

body:json {
  {
    "sub": "m-1",
    "role": "member",
    "member_id": "m-1",
    "programme_ids": [
      "p-1"
    ]
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("memberToken", res.getBody().access_token);
  }
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Dev-mode token for the seeded identity — saved to {{memberToken}}. Requires STRATA_DEV_MODE=true (never AWS).
}
