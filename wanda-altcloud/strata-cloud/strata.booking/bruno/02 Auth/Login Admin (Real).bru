meta {
  name: Login Admin (Real)
  type: http
  seq: 6
}

post {
  url: {{authBaseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "alex",
    "password": "{{seededPassword}}"
  }
}

script:post-response {
  // Same variable the dev mint fills, so every downstream request works
  // identically on a real token.
  if (res.getStatus() === 200) {
    bru.setEnvVar("adminToken", res.getBody().access_token);
  }
}

tests {
  test("login returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("response carries an access token", function () {
    expect(res.getBody()).to.have.property("access_token");
  });
}

docs {
  Real Cognito login for the seeded admin (alex → kernel profile a-1): the
  service verifies the resulting RS256 JWT through the shared identity seam —
  the production-shaped path. Requires strata.engine.auth
  running locally (authBaseUrl) and the development pool.

  The login contract is OWNED by strata.engine.auth — its collection
  (strata.engine.auth/bruno/Login.bru) is the reference; if this request
  breaks, check there first. The dev-mode mint (seq 3) remains as the
  backendless fast path; both fill {{adminToken}}.
}
