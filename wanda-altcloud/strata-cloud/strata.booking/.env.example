# Copy to .env to configure strata.booking locally. All vars are prefixed STRATA_.
#
# STRATA_DATABASE_URL is REQUIRED — the app fails fast at startup if it is unset.
# This default matches the shared workspace Postgres (root compose, port 5432 —;
# one container for the whole workspace); point it at RDS in AWS.
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata

# The verification seam (strata.identity,). Local dev verifies
# HS256 dev tokens; dev mode REQUIRES STRATA_ENVIRONMENT to be explicitly "local"
# (it fails closed otherwise). In AWS: STRATA_AUTH_MODE=cognito + the trio below.
STRATA_AUTH_MODE=dev
STRATA_ENVIRONMENT=local
# STRATA_COGNITO_REGION=eu-west-2                # cognito mode only
# STRATA_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXX  # cognito mode only
# STRATA_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx  # cognito mode only

# Dev-mode seam — local only, NEVER set in AWS. Mounts /v1/dev/* (token minting, stub
# notification viewer, simulated call records) and enables the dev auth tokens.
STRATA_DEV_MODE=true
STRATA_DEV_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

# CORS for Summit's Vite dev server (JSON list). Empty default = CORS off.
STRATA_CORS_ORIGINS=["http://localhost:5173"]

# Optional overrides (defaults shown):
# STRATA_APP_NAME="strata.booking"
# STRATA_JOBS_INTERVAL_SECONDS=0       # >0 runs all due jobs in-process every N seconds
#                                      # (hands-free local dev; otherwise `inv jobs-run`)

# Observability. Defaults are local-safe: pretty console logs, tracing off — so
# `inv dev` needs no extra infra.
# STRATA_SERVICE_NAME=strata.booking
# STRATA_LOG_FORMAT=console            # console (local) | json (AWS → CloudWatch)
# STRATA_OTEL_TRACES_EXPORTER=none     # none | console | otlp
# STRATA_OTEL_EXPORTER_OTLP_ENDPOINT=  # base URL; /v1/traces is appended
# STRATA_OTEL_TRACES_SAMPLER_RATIO=1.0
#
# To view traces locally against Jaeger (`inv trace-up`, UI at http://localhost:16686):
#   STRATA_OTEL_TRACES_EXPORTER=otlp
#   STRATA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
