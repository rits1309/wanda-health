# Copy to .env. All vars are prefixed STRATA_.

# REQUIRED — the app fails fast at startup without these two.
# The shared workspace Postgres (repo-root compose, port 5432): `inv db-up` then `inv migrate`.
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata
# Edge auth: the static shared secret ingest/registration callers send as
# X-API-Key. Any non-empty value works locally, but generate your own random one
# (`python -c "import secrets; print(secrets.token_urlsafe(32))"`) — this example value is
# published in git and must never reach a shared environment. Phase 2 replaces this with the
# provider API key.
STRATA_EDGE_SHARED_SECRET=local-dev-edge-secret

# Pipeline consumer — defaults shown:
# STRATA_PIPELINE_POLL_SECONDS=1.0     # standalone runner cadence (`inv pipeline-run`)
# STRATA_PIPELINE_RETRY_DELAY_SECONDS=30.0  # failed messages wait this long before redelivery
# STRATA_PIPELINE_INTERVAL_SECONDS=0   # >0 runs the consumer in-process every N seconds

# Dev-mode seam — local only, NEVER set in AWS. Mounts /v1/dev/* (single-shot pipeline
# run, quarantine inspection, replay) — the tooling the local readings-demo runbook drives
# the pipeline with. Fail-closed: dev mode refuses to start unless STRATA_ENVIRONMENT is
# EXPLICITLY "local", so these can never take effect on a deployed environment.
STRATA_DEV_MODE=true
STRATA_ENVIRONMENT=local

# Observability defaults are local-safe: console logs, tracing off.
# STRATA_LOG_FORMAT=console            # console (local) | json (AWS -> CloudWatch)
# STRATA_OTEL_TRACES_EXPORTER=none     # none | console | otlp
# STRATA_OTEL_EXPORTER_OTLP_ENDPOINT=  # base URL; /v1/traces is appended (e.g. a local Jaeger)
