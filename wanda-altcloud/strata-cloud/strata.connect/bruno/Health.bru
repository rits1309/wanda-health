tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("stamps a correlation id (X-Request-Id middleware)", function () {
    expect(res.headers["x-request-id"]).to.be.a("string").and.not.be.empty;
  });
}
