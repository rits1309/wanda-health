meta {
  name: Ingest Weight Reading
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": 12346,
    "device_id": "SM5000-IB-xxxx",
    "device_model": "SM5000-IB",
    "reading_type": "weight",
    "date_recorded": "2026-07-01T08:15:00",
    "date_received": "2026-07-01T08:16:05",
    "tare_kg": 0.0,
    "weight_kg": 81.6,
    "tare_lbs": 0.0,
    "weight_lbs": 180.0
  }
}

tests {
  test("202 accepted", function () {
    expect(res.getStatus()).to.equal(202);
  });

  test("returns the correlation id (the replay/trace handle)", function {
    expect(res.getBody().correlation_id).to.be.a("string").and.not.be.empty;
  });
}
