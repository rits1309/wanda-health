meta {
  name: Ingest Blood Pressure Reading
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": 12345,
    "device_id": "SM5000-IB-xxxx",
    "device_model": "SM5000-IB",
    "reading_type": "blood_pressure",
    "date_recorded": "2026-07-01T14:32:00",
    "date_received": "2026-07-01T14:33:10",
    "systolic_mmhg": 128,
    "diastolic_mmhg": 82,
    "pulse_bpm": 71,
    "irregular": false
  }
}

tests {
  test("202 accepted", function () {
    expect(res.getStatus()).to.equal(202);
  });

  test("returns the correlation id (the replay/trace handle)", function {
    expect(res.getBody().correlation_id).to.be.a("string").and.not.be.empty;
  });
}
