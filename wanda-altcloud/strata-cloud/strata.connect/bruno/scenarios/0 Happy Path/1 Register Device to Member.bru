meta {
  name: 1 Register Device to Member
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/device-registrations
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "user_id": "m-1",
    "identifier_type": "SmartMeter Scale",
    "external_id": "{{scn0Device}}"
  }
}

script:pre-request {
  // Fresh identifiers per run: the device id, and the provider reading id the
  // dedup demonstration (requests 4-5) relies on being globally unique.
  bru.setVar("scn0Device", "SM-SCN0-" + Date.now());
  bru.setVar("scn0ReadingId", Date.now());
}

tests {
  test("201 — the device is dispatched to Morgan Lee (m-1)", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().user_id).to.equal("m-1");
  });
}
