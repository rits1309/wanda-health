meta {
  name: 4 Provider Re-sends the Same Reading
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": {{scn0ReadingId}},
    "device_id": "{{scn0Device}}",
    "device_model": "SM5000-W",
    "reading_type": "weight",
    "date_recorded": "2026-07-01T08:15:00",
    "date_received": "2026-07-01T08:16:05",
    "tare_kg": 0.0,
    "weight_kg": 81.6,
    "tare_lbs": 0.0,
    "weight_lbs": 180.0
  }
}

tests {
  test("202 — the edge always captures; dedup is the Worker's job ", function {
    expect(res.getStatus()).to.equal(202);
  });
}
