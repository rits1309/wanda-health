meta {
  name: 1 Ingest Malformed Reading
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": 90002,
    "device_id": "SM-SCN3-MALFORMED",
    "device_model": "SM5000-IB",
    "reading_type": "blood_pressure",
    "date_recorded": "2026-07-01T14:32:00",
    "date_received": "2026-07-01T14:33:10",
    "systolic_mmhg": "very high"
  }
}

script:post-response {
  bru.setVar("scn3Correlation", res.getBody().correlation_id);
}

tests {
  test("202 — malformed is still captured; the edge never validates ", function {
    expect(res.getStatus()).to.equal(202);
  });
}
