meta {
  name: 4 See It in the Dead-Letter Queue
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/dev/queue/undeliverable
  body: none
  auth: none
}

tests {
  test("the message is undeliverable after first delivery + three retries ", function {
    const entry = res.getBody().undeliverable.find(
      (e) => e.correlation_id === bru.getVar("scn3Correlation")
    );
    expect(entry, "no undeliverable entry for this run's correlation id").to.exist;
    expect(entry.receive_count).to.equal(4);
  });

  test("last_error carries the error SHAPE — field + kind, none of the payload's values ", function {
    const entry = res.getBody().undeliverable.find(
      (e) => e.correlation_id === bru.getVar("scn3Correlation")
    );
    expect(entry.last_error).to.contain("systolic_mmhg");
    expect(entry.last_error).to.not.contain("very high");
  });
}

docs {
  The mirror of `inv undeliverable` (which also lists possibly-stuck in_flight claims —
  a hard-killed consumer's committed claim). The raw payload is intact in raw_readings:
  once the FAULT is fixed, `inv replay --correlation-id <id>` re-enqueues it
. This payload is malformed at source, so replaying it unchanged would
  simply dead-letter again — the resolve-by-replay flow is scenario 2's ending.
  Entries from earlier runs of this scenario accumulate here; the tests match on this
  run's correlation id only.
}
