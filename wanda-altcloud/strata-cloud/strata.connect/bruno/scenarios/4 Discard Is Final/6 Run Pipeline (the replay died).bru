meta {
  name: 6 Run Pipeline (the replay died)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/dev/pipeline/run
  body: none
  auth: none
}

tests {
  test("nothing processes into a reading — the replay was cancelled by the discard", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().processed).to.equal(0);
  });
}

docs {
  The replay entry was cancelled at discard time, so the queue has nothing ready.
  Had a consumer already CLAIMED the entry (the racing case), the Processor's own
  discard check would drop it instead — acked with a "discarded correlation
  dropped" log line, never attributed, never re-quarantined.
}
