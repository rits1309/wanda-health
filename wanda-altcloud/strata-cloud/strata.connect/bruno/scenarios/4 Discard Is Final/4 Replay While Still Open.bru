meta {
  name: 4 Replay While Still Open
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/dev/replay
  body: json
  auth: none
}

body:json {
  {
    "correlation_id": "{{scn4Correlation}}"
  }
}

tests {
  test("202 — the record is still open, so replay is allowed", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().prior_entries).to.eql({ done: 1 });
  });
}

docs {
  The first half of the bypass sequence: a perfectly legal replay, requested while
  the quarantine record is still open. The message it enqueues is now sitting in
  the queue — and the next request discards the record out from under it.
}
