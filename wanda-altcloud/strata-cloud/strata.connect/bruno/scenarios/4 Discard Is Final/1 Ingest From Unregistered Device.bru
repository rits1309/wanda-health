meta {
  name: 1 Ingest From Unregistered Device
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": {{scn4ReadingId}},
    "device_id": "{{scn4Device}}",
    "device_model": "SM5000-IB",
    "reading_type": "blood_pressure",
    "date_recorded": "2026-07-01T14:32:00",
    "date_received": "2026-07-01T14:33:10",
    "systolic_mmhg": 128,
    "diastolic_mmhg": 82,
    "pulse_bpm": 71,
    "irregular": false
  }
}

script:pre-request {
  // Fresh identifiers per run: the device stays unregistered so the reading always
  // quarantines, and the provider reading id must be globally unique.
  bru.setVar("scn4Device", "SM-SCN4-" + Date.now());
  bru.setVar("scn4ReadingId", Date.now());
}

script:post-response {
  bru.setVar("scn4Correlation", res.getBody().correlation_id);
}

tests {
  test("202 — captured verbatim before any validation ", function {
    expect(res.getStatus()).to.equal(202);
  });

  test("a correlation id is assigned at ingest — the trace handle ", function {
    expect(res.getBody().correlation_id).to.be.a("string").and.not.be.empty;
  });
}
