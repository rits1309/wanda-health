meta {
  name: 3 See It in Quarantine
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/dev/quarantine
  body: none
  auth: none
}

tests {
  test("the reading is on the open worklist, identifiers only ", function {
    const record = res.getBody().find(function (q) {
      return q.correlation_id === bru.getVar("scn4Correlation");
    });
    expect(record).to.not.be.undefined;
    expect(record.state).to.equal("open");
    expect(record.device_id).to.equal(bru.getVar("scn4Device"));
  });
}
