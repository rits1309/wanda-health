meta {
  name: 8 Run Pipeline (reading lands)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/dev/pipeline/run
  body: none
  auth: none
}

tests {
  test("the replayed delivery is processed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().processed).to.be.at.least(1);
  });
}

docs {
  This run attributes the replayed reading to m-1 (the device is registered now),
  persists it, and resolves the open quarantine record — all in one transaction.
  (The count can exceed 1: request 3's non-object payload retries on its own ladder.)
}
