meta {
  name: 5 See It in Quarantine
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/dev/quarantine
  body: none
  auth: none
}

tests {
  test("the reading sits on the open quarantine worklist ", function {
    const record = res.getBody().find(
      (q) => q.correlation_id === bru.getVar("scn2Correlation")
    );
    expect(record, "no open record for this run's correlation id").to.exist;
    expect(record.device_id).to.equal(bru.getVar("scn2Device"));
    expect(record.state).to.equal("open");
  });

  test("identifiers only — the record points at the raw payload, copies no values ", function {
    const record = res.getBody().find(
      (q) => q.correlation_id === bru.getVar("scn2Correlation")
    );
    expect(Object.keys(record).sort()).to.eql(
      ["correlation_id", "created_at", "device_id", "id", "reading_type", "state"]
    );
  });
}

docs {
  The mirror of `inv quarantine` — the operator's worklist. Resolution is manual for
  MVP, per the recommended approach: register the device, then replay. Requests 6-9
  do exactly that. (The other exit is `inv quarantine-discard` — final: replay refuses
  a discarded correlation.)
}
