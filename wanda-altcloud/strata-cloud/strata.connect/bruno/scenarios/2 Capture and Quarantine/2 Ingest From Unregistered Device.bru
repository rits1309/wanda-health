meta {
  name: 2 Ingest From Unregistered Device
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/readings
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "reading_id": {{scn2ReadingId}},
    "device_id": "{{scn2Device}}",
    "device_model": "SM5000-W",
    "reading_type": "weight",
    "date_recorded": "2026-07-01T08:15:00",
    "date_received": "2026-07-01T08:16:05",
    "tare_kg": 0.0,
    "weight_kg": 81.6,
    "tare_lbs": 0.0,
    "weight_lbs": 180.0
  }
}

script:pre-request {
  // Fresh identifiers per run: request 6 REGISTERS this device (the resolution flow),
  // so a fixed id would stop quarantining on the second run; and the resolved reading
  // persists, so its provider reading id must be globally unique.
  bru.setVar("scn2Device", "SM-SCN2-" + Date.now());
  bru.setVar("scn2ReadingId", Date.now());
}

script:post-response {
  bru.setVar("scn2Correlation", res.getBody().correlation_id);
}

tests {
  test("202 — captured verbatim before any validation ", function {
    expect(res.getStatus()).to.equal(202);
  });

  test("a correlation id is assigned at ingest — the reading's trace handle ", function {
    expect(res.getBody().correlation_id).to.be.a("string").and.not.be.empty;
  });
}
