meta {
  name: 9 Quarantine Worklist Is Clear
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/dev/quarantine
  body: none
  auth: none
}

tests {
  test("the record left the open worklist — resolved, with its history retained", function () {
    const record = res.getBody().find(
      (q) => q.correlation_id === bru.getVar("scn2Correlation")
    );
    expect(record, "the record should no longer be open").to.not.exist;
  });
}

docs {
  The full manual resolution loop, closed: quarantined → listed → device
  registered → replayed → persisted for m-1, record resolved. The resolved row
  survives in quarantined_readings as history (state `resolved`, not deleted).
}
