meta {
  name: 6 Register the Device
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/device-registrations
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "user_id": "m-1",
    "identifier_type": "SmartMeter Scale",
    "external_id": "{{scn2Device}}"
  }
}

tests {
  test("201 — the quarantined reading's device now belongs to Morgan Lee (m-1)", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().user_id).to.equal("m-1");
  });
}

docs {
  The fix. The quarantine record itself is untouched — registration alone resolves
  nothing (no automated reprocessing, per 's manual-first recommendation). The
  replay does that. Note each run of this scenario leaves one registration on m-1
  (synthetic fixture member; harmless locally, never cleaned up).
}
