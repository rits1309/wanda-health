meta {
  name: 2 Same Registration Again (idempotent)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/device-registrations
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "user_id": "m-1",
    "identifier_type": "SmartMeter Scale",
    "external_id": "{{scn1Device}}"
  }
}

tests {
  test("201 — an at-least-once dispatch caller can retry safely", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("the SAME mapping comes back — no flip-flop in the audit trail", function () {
    expect(res.getBody().id).to.equal(bru.getVar("scn1MappingId"));
  });
}
