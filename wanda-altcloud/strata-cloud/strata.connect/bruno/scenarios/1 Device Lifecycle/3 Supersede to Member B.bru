meta {
  name: 3 Supersede to Member B
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/device-registrations
  body: json
  auth: none
}

headers {
  X-API-Key: {{edgeSecret}}
}

body:json {
  {
    "user_id": "m-2",
    "identifier_type": "SmartMeter Scale",
    "external_id": "{{scn1Device}}"
  }
}

tests {
  test("201 — the device now belongs to m-2 ", function {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().user_id).to.equal("m-2");
  });

  test("the response names the superseded member — m-1's mapping was ended, not deleted", function () {
    expect(res.getBody().superseded_user_id).to.equal("m-1");
  });
}
