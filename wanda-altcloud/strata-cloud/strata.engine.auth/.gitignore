# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Runtime / logs ---
*.log

# --- Bruno: local environment holds credentials + live tokens ---
# Keep the *.example template tracked; ignore the real env that tokens write into.
bruno/environments/*.bru
!bruno/environments/*.example.bru

# --- Editors / OS ---
# NOTE: .vscode/ is intentionally tracked (shared interpreter + venv terminal profile).
.idea/
*.swp
.DS_Store

.vscode/zsh/.zsh_history