# Copy to .env. All keys use the baseline STRATA_ prefix (the old COGNITO_* names
# are retired — see README migration note). Values below are the savanna-dev pool
# (the single platform user pool) — README records its configuration;
# the ids change when the pool is recreated.
STRATA_COGNITO_REGION=eu-west-2
STRATA_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
STRATA_COGNITO_CLIENT_ID=your-app-client-id
# Only needed if you created the app client WITH a secret. The summit client has none.
# STRATA_COGNITO_CLIENT_SECRET=

# Named AWS profile for the CREDENTIALED admin client (`inv seed` and the
# migration login's Admin* operations). Leave unset to use the default credential
# chain (`aws login` / a deployed IAM role). Never long-lived keys, here or anywhere.
# STRATA_AWS_PROFILE=

# The legacy platform's credentials-check endpoint — the migration login
# (Identity). Unset → the migration branch is disabled and an
# unknown user fails with the same generic error as a wrong password.
# UAT needs no API key; the production endpoint will (env/secrets only).
# STRATA_LEGACY_API_BASE_URL=https://legacy-platform.example.com
# STRATA_LEGACY_API_KEY=
# STRATA_LEGACY_TIMEOUT_SECONDS=3.0

# The pool password policy, MIRRORED: the migration login checks a
# legacy password against these before any Cognito call; failure returns the 409
# upgrade challenge. Defaults = the Cognito defaults, which savanna-dev keeps.
# Change the pool policy ⇒ change these together (drift is compensated + logged).
# STRATA_PASSWORD_MIN_LENGTH=8
# STRATA_PASSWORD_REQUIRE_UPPERCASE=true
# STRATA_PASSWORD_REQUIRE_LOWERCASE=true
# STRATA_PASSWORD_REQUIRE_DIGIT=true
# STRATA_PASSWORD_REQUIRE_SYMBOL=true

# Comma-separated browser origins allowed to call this API (CORS).
# Defaults to the Vite/CRA dev servers if unset.
# STRATA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Observability — local-safe defaults: console logs, tracing off.
# STRATA_LOG_FORMAT=console
# STRATA_OTEL_TRACES_EXPORTER=none
# STRATA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The SHARED workspace PostgreSQL — the repo-root docker-compose.yml (port 5432).
# The schema (identity tables included) is owned by ../strata.core's single
# canonical history (run `inv db-up && inv migrate` in ../strata.core first).
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata

# Verification seam mode (strata.identity): cognito (default) or dev (local only).
# Dev mode REQUIRES STRATA_ENVIRONMENT to be explicitly set to "local" — the
# Settings default does not count (an unset environment fails closed).
# STRATA_AUTH_MODE=cognito
# STRATA_DEV_AUTH_SECRET=
# STRATA_ENVIRONMENT=local

# Gates dev-only surfaces (`inv seed`). Never set in a deployed environment.
STRATA_DEV_MODE=true
