meta {
  name: Me
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns 200 with a valid access token", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the enriched principal (profile + roles)", function () {
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.not.have.property("cognito_sub");
    expect(body).to.have.property("email");
    expect(body).to.have.property("first_name");
    expect(body).to.have.property("last_name");
    expect(body).to.have.property("display_name"); // effective
    expect(body).to.have.property("display_name_override");  // raw override, may be null
    expect(body).to.have.property("timezone");
    expect(body).to.have.property("preferred_language");     // may be null
    expect(body.languages).to.be.an("array");
    expect(body.roles).to.be.an("array");
  });
}

docs {
  Protected route. Sends the saved {{accessToken}} as a Bearer token; the
  backend verifies it against the Cognito JWKS and returns the enriched
  principal (strata.identity's UserProfileOut): the user_profiles row
  (id, email, first_name, last_name, the effective display_name plus the
  raw display_name_override, timezone, preferred_language, languages) plus
  the coarse role names from the token's cognito:groups (e.g. ["Coach"]).
  The raw editable fields were added at for the profile page;
  Update Me saves them back, Languages serves the checkbox catalogue. The
  spoken languages are ISO codes derived from the user_languages links.
  Clients key on id — cognito_sub left the contract. A
  verified subject with no resolvable profile is a 403; nothing is
  provisioned.
  Run Login first so {{accessToken}} is populated.
}
