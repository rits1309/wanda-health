meta {
  name: PasswordUpgrade
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/auth/password-upgrade
  body: json
  auth: none
}

body:json {
  {
    "identifier": "{{identifier}}",
    "password": "{{password}}",
    "new_password": "{{newPassword}}"
  }
}

script:post-response {
  // A successful upgrade signs the user in — persist the tokens like Login does.
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("accessToken", body.access_token);
    bru.setEnvVar("idToken", body.id_token);
    if (body.refresh_token) {
      bru.setEnvVar("refreshToken", body.refresh_token);
    }
  }
}

docs {
  Completes a guided password upgrade (Identity):
  use it after Login returned the 409 password_upgrade_required challenge.
  Statelessly re-proves the legacy credentials, re-runs the migration gate,
  and creates the Cognito account with new_password (which must meet the
  pool password policy — a non-compliant one gets the same static 409
  challenge back). Anything else — wrong old password, an already-migrated account —
  fails with the same generic 401 as Login; the endpoint never
  changes an existing account's password.
}
