meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "{{identifier}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Persist the tokens into the active environment so other requests
  // (e.g. "Me") can use {{accessToken}} without copy-pasting.
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("accessToken", body.access_token);
    bru.setEnvVar("idToken", body.id_token);
    if (body.refresh_token) {
      bru.setEnvVar("refreshToken", body.refresh_token);
    }
  }
}

tests {
  test("login returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("response carries an access token", function () {
    expect(res.getBody()).to.have.property("access_token");
  });
}

docs {
  Exchanges identifier (username or email) + password for
  Cognito tokens (USER_PASSWORD_AUTH).
  On success the post-response script saves accessToken / idToken /
  refreshToken into the active environment for downstream requests.
  Works for any confirmed user — e.g. the seeded development cast
  (see README: dana or seed-dana@wandahealth.com etc., password
  Savanna-Dev!2026 — the pool's email alias resolves either form).
}
