# Copy to .env. All vars are prefixed STRATA_.

# The shared workspace Postgres (repo-root docker-compose.yml, port 5432 — inv db-up).
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata

# The verification seam (strata.identity). Every /v1 route requires a valid
# bearer token (any authenticated user). cognito verifies pool access tokens; dev verifies
# local HS256 tokens and only starts when STRATA_ENVIRONMENT is EXPLICITLY "local".
#
# `auth_mode` defaults to "cognito", so these three must be SET (not just present as
# comments) for local work — otherwise the service starts in cognito mode with no pool
# configured and every /v1 request fails. Mint a token with `inv token`. The secret
# matches strata.booking's example so one dev token works across both services.
STRATA_AUTH_MODE=dev
STRATA_ENVIRONMENT=local
STRATA_DEV_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Cognito mode (AWS / real-login local): set these instead of the three dev vars above.
# STRATA_AUTH_MODE=cognito
# STRATA_COGNITO_REGION=
# STRATA_COGNITO_USER_POOL_ID=
# STRATA_COGNITO_CLIENT_ID=

# CORS for the local Vite dev server (Summit); off by default.
# STRATA_CORS_ORIGINS=["http://localhost:5173"]

# Observability defaults are local-safe: console logs, tracing off.
# STRATA_LOG_FORMAT=console            # console (local) | json (AWS -> CloudWatch)
# STRATA_OTEL_TRACES_EXPORTER=none     # none | console | otlp
# STRATA_OTEL_EXPORTER_OTLP_ENDPOINT=  # base URL; /v1/traces is appended (e.g. a local Jaeger)
