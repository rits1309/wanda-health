# Variable reference — nothing auto-loads a .env file in this package. The value
# below is the default already baked into alembic.ini (matching docker-compose.yml);
# EXPORT the variable in your shell to target a different database:
#   export STRATA_DATABASE_URL=postgresql+asyncpg://...
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata
